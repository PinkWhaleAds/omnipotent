# Copy to terraform.tfvars (git-ignored) and fill in. No secret goes here: the secret values are put in Secrets
# Manager by hand after the first apply (infra/README.md, "Test environment"). Everything that differs from production
# is already in test_override.tf; a value set here wins over it.

# --- Required -------------------------------------------------------------------------------------

# Auth0: the tenant, the REST API identifier and the Single Page Application (public values).
auth0_domain        = "your-tenant.eu.auth0.com"
auth0_audience      = "https://api.omnipotent.test"
auth0_spa_client_id = "SPA-client-id"

# Get the super-admin flag on their first verified sign-in (Auth0 database or Google connection). With the local
# implementation of the rights (test_override.tf), every other verified identity signs in as well.
super_admin_emails = ["you@example.com"]

# --- Recommended ----------------------------------------------------------------------------------

# Alarm e-mails (confirm the subscription e-mail AWS sends). The spending is capped by the project's spend limit in AWS
# Settings (README), so no AWS budget here (monthly_budget_usd would watch the whole account, other projects included).
# alarm_email = "you@example.com"

# --- Switches you may want while testing (defaults in test_override.tf) ---------------------------

# api_cpu    = 512                 # with api_memory = 1024 if the API task runs short of memory (exit code 137)
# api_memory = 1024
# docs_enabled = false             # the Swagger UI is on in test
# log_level    = "debug"
# task_egress  = "nat"             # a NAT gateway and a fixed egress IP (allow-list tests), about 35 USD a month
# waf_enabled  = true              # refused by this account's policies (README); try it only to check
# Once omnipass answers, the test environment can run it too (and then NODE_ENV may go back to "prod"):
# access_provider = "omnipass"
# node_env        = "prod"
