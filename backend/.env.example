# Copy to `.env` (git-ignored) and fill in. `pnpm start`, `pnpm start:dev` and the
# TypeORM scripts load it; `docker compose` passes it to the containers.
# Never commit real secrets.

# --- Process ---------------------------------------------------------------
# api (HTTP + MCP) or worker (job workers + probes). `pnpm start:worker` sets it.
APP_MODE=api
APP_LOG_LEVEL=debug
# Swagger UI and /documentation/json: on by default, off in prod.
# APP_DOCS_ENABLED=true
# Web front ends allowed to call the API from a browser (CORS), comma-separated.
# None by default; multi-search's front runs on http://localhost:5173.
# APP_CORS_ORIGINS=http://localhost:5173

# --- Identity and permissions (omnipass) -------------------------------------
# Where the caller's identity and roles come from:
#   local    — the development STUB: every caller is the fixed actor below, admin of every
#              Organization and seat_admin of every Seat, and no membership is read.
#   omnipass — @omnilor/omnipass-client, the only writer of the tenancy being omnipass itself. The
#              only provider production accepts (D43); it ships at omnipass's phase 7, so it
#              refuses to start for now.
# The application refuses to start with NODE_ENV=prod and anything but omnipass.
# ACCESS_PROVIDER=local
# How long a resolved snapshot is reused before omnipass is asked again (T3).
# ACCESS_CACHE_TTL=60000

# The fixed actor the stub resolves every caller to. Nothing here is a credential: the token is
# still verified against Auth0, only the identity behind it is stubbed.
# DEV_ACTOR_USER_ID=00000000-0000-4000-8000-000000000002
# DEV_ACTOR_EMAIL=dev@omnipotent.local
# DEV_ACTOR_SUPER_ADMIN=true

# When the real client is wired (omnipass phase 7), these four replace the stub. The secret lives in
# Secrets Manager, never here.
# OMNIPASS_URL=
# OMNIPASS_AUDIENCE=
# OMNIPASS_CLIENT_ID=
# OMNIPASS_CLIENT_SECRET=

# --- Database (docker compose up -d postgres) --------------------------------
DB_HOST=localhost
DB_PORT=5441
DB_USER=omnipotent
DB_PASSWORD=omnipotent
DB_NAME=omnipotent

# --- Object storage (docker compose up -d rustfs) ---------------------------
# The defaults (config/default.json) point at the local RustFS on localhost:9012 and create the
# bucket on startup; on AWS leave the endpoint and keys empty so the IAM role is used.
# S3_ENDPOINT=http://localhost:9012
# S3_BUCKET=omnipotent-assets
# S3_ACCESS_KEY_ID=local-access-key
# S3_SECRET_ACCESS_KEY=local-secret-key

# --- Secrets (docker compose up -d moto) -------------------------------------
# The defaults (config/default.json) point at the local moto emulator on localhost:9022; on AWS
# leave the endpoint and keys empty so the IAM role is used. Every secret name is prefixed
# `omnipotent/<env>/…`.
# SECRETS_ENDPOINT=http://localhost:9022
# SECRETS_PREFIX=omnipotent

# --- Auth0 -----------------------------------------------------------------
# Tenant domain, shown at the top right of the Auth0 dashboard. The tenant is shared with
# multi-search (D42); Omnipotent has its own two audiences in it.
AUTH0_DOMAIN=
# Identifier of the Auth0 API created for the REST API of Omnipotent (Applications > APIs).
# It is an identifier, not a URL that must answer.
AUTH0_AUDIENCE=https://api.omnipotent.app
# Auth0 application (SPA) used by the "Authorize" button of the Swagger UI.
# Its Allowed Callback URLs must include http://localhost:3000/documentation/static/oauth2-redirect.html
AUTH0_SWAGGER_CLIENT_ID=
# The email, the verified-provider list and the super-admin flag are omnipass's, not ours: nothing
# of the caller's rights travels in the token (T3).

# --- MCP -------------------------------------------------------------------
# Public URL of the MCP endpoint. It must equal the identifier of the Auth0 API created for the MCP
# server, which is not the REST API's (AUTH0_AUDIENCE): the API refuses to start otherwise.
MCP_RESOURCE_URL=http://localhost:3000/mcp
# Client id of the Auth0 Native application the Claude connectors (claude.ai, Claude Desktop) sign in
# with: not a secret. Empty: no connector is registered yet.
# MCP_CLAUDE_CLIENT_ID=
