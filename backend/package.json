{
  "name": "omnipotent",
  "version": "0.0.0",
  "description": "Multi-platform media buying API \u2014 backend",
  "main": "dist/index.js",
  "engines": {
    "pnpm": ">=10.0.0",
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "test": "pnpm test:unit",
    "test:cov": "pnpm test:unit:cov",
    "test:unit": "jest",
    "test:unit:cov": "jest --coverageDirectory=coverage-unit --testResultsProcessor=\"jest-junit\" --coverage true",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=.env ./src/index.ts",
    "start:dev": "tsx watch --env-file-if-exists=.env ./src/index.ts",
    "start:worker": "APP_MODE=worker tsx watch --env-file-if-exists=.env ./src/index.ts",
    "start:instrumented": "tsx --env-file-if-exists=.env --import ./src/instrumentation.ts ./src/index.ts",
    "typeorm": "tsx --env-file-if-exists=.env ./node_modules/typeorm/cli.js -d ./src/database/cli-data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/rds-signer": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/ajv-compiler": "^4.0.7",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "config": "^4.4.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "overrides": {
      "light-my-request": "6.6.0",
      "@fastify/static>content-disposition": "2.0.1"
    }
  }
}
